# AI API Reliability Assistant - Environment Variables Configuration
# NOTE: The application works 100% locally and free out-of-the-box using the built-in deterministic QA engine.
# No paid subscription or API key is required.

# (OPTIONAL) Google Gemini Free Tier API Key
# If provided, the assistant can optionally query Gemini for natural language plan enrichment.
# Get a free API key at: https://aistudio.google.com/
VITE_AI_API_KEY=

# (OPTIONAL) Model Selection (Default: gemini-1.5-flash)
VITE_AI_MODEL=gemini-1.5-flash

# (OPTIONAL) Alternative Provider: 'local' | 'gemini' | 'openai'
VITE_AI_PROVIDER=local
